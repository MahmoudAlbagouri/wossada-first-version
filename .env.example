# Base URL of the NestJS API (no trailing slash). Also set it at build time:
# @nuxt/image only optimizes images from this host (plus NUXT_IMAGE_DOMAINS).
NUXT_PUBLIC_API_BASE=http://localhost:3006

# Public URL of this storefront: canonical links, Open Graph, sitemap, robots.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_SITE_URL=http://localhost:3000

# Overrides the store name from app/app.config.ts (both languages). Optional.
NUXT_PUBLIC_SITE_NAME=

# `ipx` resizes/converts images through this server; `none` serves originals.
NUXT_PUBLIC_IMAGE_PROVIDER=ipx

# Extra image hosts (comma separated), e.g. a CDN in front of /uploads.
NUXT_IMAGE_DOMAINS=

# Must equal the API's FREE_SHIPPING_THRESHOLD (0 hides the promo).
NUXT_PUBLIC_FREE_SHIPPING_THRESHOLD=0
